@page
@model Clinic.Web.Pages.Account.RegisterModel
@{
    ViewData["Title"] = L["Sign up"];
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6 auth-panel">
        <h1 class="h3 mb-2">@L["Patient sign up"]</h1>
        <p class="text-muted mb-4">@L["Are you a doctor?"] <a asp-page="./RegisterDoctor">@L["Doctor sign up"]</a></p>
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <partial name="_BotCheck" />
            <partial name="_RegisterFields" for="Input" />
            <button type="submit" class="btn btn-success w-100">@L["Sign up"]</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
