@page
@model Clinic.Web.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = L["Forgot your password?"];
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5 auth-panel">
        <h1 class="h3 mb-2">@L["Forgot your password?"]</h1>
        @if (Model.Sent)
        {
            <div class="alert alert-success" role="status">
                @L["If an account uses this email, we have sent it a link to choose a new password. Check your inbox and spam folder. If nothing arrives, call the clinic."]
            </div>
            <a asp-page="./Login">@L["Back to log in"]</a>
        }
        else
        {
            <p class="text-muted mb-4">@L["Enter the email of your account and we will send you a link to choose a new password."]</p>
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <partial name="_BotCheck" />
                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" autocomplete="username" dir="ltr" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn btn-success w-100">@L["Send the link"]</button>
            </form>
            <p class="mt-3 small text-muted">@L["Registered at the clinic without an email? Call the clinic to have your password reset."]</p>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
