@page
@model Clinic.Web.Pages.Admin.UsersModel
@{
    ViewData["Title"] = L["Users"];
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h1 class="h3 mb-0">@L["Users"]</h1>
    <form method="get" class="d-flex gap-2">
        <input class="form-control" name="Q" value="@Model.Q" placeholder="@L["Search name, email or mobile"]" />
        <button class="btn btn-outline-success">@L["Search"]</button>
    </form>
    <a class="btn btn-success" asp-page="./UserCreate"><i class="bi bi-person-plus me-1"></i>@L["New user"]</a>
</div>

<div class="table-responsive">
    <table class="table bg-white align-middle">
        <thead>
            <tr>
                <th>@L["Name"]</th>
                <th>@L["Contact"]</th>
                <th>@L["Roles"]</th>
                <th>@L["Status"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model.Rows)
            {
                <tr class="@(r.User.IsActive ? "" : "table-secondary")">
                    <td>
                        @r.User.FullName
                        <div class="small text-muted">@Fmt.Date(r.User.CreatedUtc)</div>
                        @if (r.Doctor is not null)
                        {
                            <div class="small">@L["Medical Council number"]: <span dir="ltr">@r.Doctor.MedicalCouncilNumber</span></div>
                            @if (!r.Doctor.IsApproved)
                            {
                                <a class="btn btn-sm btn-warning mt-1" asp-page="./DoctorRequests" asp-fragment="d@(r.Doctor.Id)">@L["Review documents"]</a>
                            }
                        }
                    </td>
                    <td class="small" dir="ltr">@r.User.Email<br />@r.User.PhoneNumber</td>
                    @if (r.Roles.Contains(Roles.Owner) && !User.IsInRole(Roles.Owner))
                    {
                        @* Only the owner changes the owner's account; the admin just sees it. *@
                        <td>
                            <span class="badge bg-dark mb-1"><i class="bi bi-shield-lock me-1"></i>@L["Site owner"]</span>
                            @foreach (var role in Roles.All.Where(r.Roles.Contains))
                            {
                                <span class="badge bg-success mb-1">@L[role]</span>
                            }
                        </td>
                        <td><span class="small text-muted">@L["Protected"]</span></td>
                    }
                    else
                    {
                    <td>
                        @if (r.Roles.Contains(Roles.Owner))
                        {
                            <span class="badge bg-dark mb-1"><i class="bi bi-shield-lock me-1"></i>@L["Site owner"]</span>
                        }
                        @foreach (var role in Roles.All)
                        {
                            var has = r.Roles.Contains(role);
                            <form method="post" asp-page-handler="ToggleRole" asp-route-id="@r.User.Id" asp-route-role="@role" asp-route-Q="@Model.Q" class="d-inline">
                                <button type="submit" class="btn btn-sm mb-1 @(has ? "btn-success" : "btn-outline-secondary")"
                                        title="@(has ? L["Remove role"] : L["Add role"])">@L[role]</button>
                            </form>
                        }
                    </td>
                    <td>
                        <form method="post" asp-page-handler="ToggleActive" asp-route-id="@r.User.Id" asp-route-Q="@Model.Q">
                            <button type="submit" class="btn btn-sm @(r.User.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                @(r.User.IsActive ? L["Deactivate"] : L["Activate"])
                            </button>
                        </form>
                        @if (r.User.Id != Model.CurrentUser)
                        {
                            @if (r.User.TwoFactorEnabled)
                            {
                                <div class="small text-success mt-2"><i class="bi bi-shield-check me-1" aria-hidden="true"></i>@L["Two-step login is on"]</div>
                                <form method="post" asp-page-handler="ResetTwoFactor" asp-route-id="@r.User.Id" asp-route-Q="@Model.Q"
                                      data-confirm="@L["Turn off two-step login of {0}? Do this only if they lost their phone.", r.User.FullName]">
                                    <button type="submit" class="btn btn-sm btn-link px-0">@L["Turn off two-step login"]</button>
                                </form>
                            }
                            <details class="mt-2">
                                <summary class="small">@L["Set a new password"]</summary>
                                <form method="post" asp-page-handler="SetPassword" asp-route-id="@r.User.Id" asp-route-Q="@Model.Q" class="d-flex gap-1 mt-1">
                                    <input type="text" name="newPassword" class="form-control form-control-sm" dir="ltr" autocomplete="off" required minlength="8" aria-label="@L["New password"]" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">@L["Save"]</button>
                                </form>
                            </details>
                        }
                    </td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>
