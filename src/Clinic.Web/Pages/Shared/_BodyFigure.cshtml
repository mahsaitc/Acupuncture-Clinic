@model Clinic.Domain.Entities.BodyView
@{
    // The same silhouette for both views; drawn twice (outline, then fill) so overlapping limbs merge.
    var front = Model == Clinic.Domain.Entities.BodyView.Front;
}
@functions {
    private const string Torso = "M70 86 C56 88 51 96 53 108 L61 150 C63 172 67 190 70 205 C66 220 64 232 64 246 C76 256 88 262 100 263 C112 262 124 256 136 246 C136 232 134 220 130 205 C133 190 137 172 139 150 L147 108 C149 96 144 88 130 86 Z";
}
<g class="figure">
    <g class="outline">
        <ellipse cx="100" cy="40" rx="21" ry="26" />
        <path d="@Torso" />
        <line x1="100" y1="60" x2="100" y2="90" stroke-width="23" />
        <line x1="57" y1="100" x2="44" y2="185" stroke-width="23" />
        <line x1="143" y1="100" x2="156" y2="185" stroke-width="23" />
        <line x1="44" y1="185" x2="34" y2="262" stroke-width="19" />
        <line x1="156" y1="185" x2="166" y2="262" stroke-width="19" />
        <ellipse cx="31" cy="281" rx="10" ry="17" transform="rotate(8 31 281)" />
        <ellipse cx="169" cy="281" rx="10" ry="17" transform="rotate(-8 169 281)" />
        <line x1="82" y1="250" x2="80" y2="345" stroke-width="35" />
        <line x1="118" y1="250" x2="120" y2="345" stroke-width="35" />
        <line x1="80" y1="345" x2="82" y2="440" stroke-width="25" />
        <line x1="120" y1="345" x2="118" y2="440" stroke-width="25" />
        <ellipse cx="80" cy="452" rx="12" ry="15" />
        <ellipse cx="120" cy="452" rx="12" ry="15" />
    </g>
    <g class="fill">
        <ellipse cx="100" cy="40" rx="21" ry="26" />
        <path d="@Torso" />
        <line x1="100" y1="60" x2="100" y2="90" stroke-width="20" />
        <line x1="57" y1="100" x2="44" y2="185" stroke-width="20" />
        <line x1="143" y1="100" x2="156" y2="185" stroke-width="20" />
        <line x1="44" y1="185" x2="34" y2="262" stroke-width="16" />
        <line x1="156" y1="185" x2="166" y2="262" stroke-width="16" />
        <ellipse cx="31" cy="281" rx="10" ry="17" transform="rotate(8 31 281)" />
        <ellipse cx="169" cy="281" rx="10" ry="17" transform="rotate(-8 169 281)" />
        <line x1="82" y1="250" x2="80" y2="345" stroke-width="32" />
        <line x1="118" y1="250" x2="120" y2="345" stroke-width="32" />
        <line x1="80" y1="345" x2="82" y2="440" stroke-width="22" />
        <line x1="120" y1="345" x2="118" y2="440" stroke-width="22" />
        <ellipse cx="80" cy="452" rx="12" ry="15" />
        <ellipse cx="120" cy="452" rx="12" ry="15" />
    </g>
    <g class="detail">
        @if (front)
        {
            <path d="M92 37 q3 -2 6 0 M102 37 q3 -2 6 0" />
            <path d="M96 54 q4 3 8 0" />
            <path d="M78 124 q10 8 20 2 M102 126 q10 6 20 -2" />
            <circle cx="100" cy="200" r="1.6" />
            <path d="M100 150 L100 196" opacity=".35" />
        }
        else
        {
            <path d="M100 88 L100 250" />
            <path d="M74 104 q8 22 16 30 M126 104 q-8 22 -16 30" opacity=".6" />
            <path d="M84 258 q16 10 32 0" opacity=".6" />
        }
    </g>
</g>
