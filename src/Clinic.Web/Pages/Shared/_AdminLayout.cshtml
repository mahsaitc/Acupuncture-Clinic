@using Microsoft.EntityFrameworkCore
@inject Clinic.Infrastructure.Data.ClinicDbContext Db
@inject Clinic.Web.Clinical.StaffScope Scope
@inject Clinic.Web.Media.SiteContentProvider SiteContent
@{
    var brand = await SiteContent.BrandAsync();
    var isOwner = User.IsInRole(Roles.Owner);
    var english = CulturePath.IsEnglish;
    var path = (ViewContext.RouteData.Values["page"] as string) ?? "";
    var isAdmin = User.IsInRole(Roles.Admin);
    var isDoctor = User.IsInRole(Roles.Doctor);
    var unread = await (await Scope.MessagesAsync(Db.ContactMessages)).CountAsync(m => m.ReadUtc == null && !m.IsArchived);
    var pendingDoctors = isAdmin ? await Db.Doctors.CountAsync(d => !d.IsApproved && Db.Users.Any(u => u.Id == d.UserId && u.IsActive)) : 0;

    var userId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var userName = userId is null ? null : await Db.Users.Where(u => u.Id == userId).Select(u => u.FullName).FirstOrDefaultAsync();
    userName = string.IsNullOrWhiteSpace(userName) ? User.Identity?.Name : userName;
    var roleNames = string.Join(english ? ", " : "، ", new[] { Roles.Owner, Roles.Admin, Roles.Doctor, Roles.Receptionist }.Where(User.IsInRole).Select(r => L[r].Value));

    string Active(string page) => path == page || path.StartsWith(page + "/") ? "active" : "";
}
<!DOCTYPE html>
<html lang="@(english ? "en" : "fa")" dir="@(english ? "ltr" : "rtl")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>@ViewData["Title"] - @L["Management panel"]</title>
    @if (brand.CustomLogo)
    {
        <link rel="icon" href="@brand.LogoPath" />
    }
    else
    {
        <link rel="icon" href="~/favicon.ico" sizes="any" />
        <link rel="icon" href="~/img/favicon-32.png" type="image/png" />
    }
    <link rel="stylesheet" href="~/lib/vazirmatn/vazirmatn.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    @if (english)
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    }
    else
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    }
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/refresh.css" media="screen" asp-append-version="true" />
    <partial name="_BrandTheme" model="brand" />
</head>
<body class="admin-body">
    <div class="admin-shell">
        <aside class="admin-sidebar offcanvas-lg offcanvas-start" tabindex="-1" id="adminSidebar" aria-label="@L["Management panel"]">
            <div class="admin-brand">
                <span class="brand-logo-chip"><img src="@brand.LogoPath" alt="" class="brand-logo" width="44" height="51" /></span>
                <div>
                    <div class="fw-bold">@brand.Title</div>
                    <div class="small opacity-75">@L["Management panel"]</div>
                </div>
                <button type="button" class="btn-close btn-close-white ms-auto d-lg-none" data-bs-dismiss="offcanvas" data-bs-target="#adminSidebar" aria-label="@L["Close"]"></button>
            </div>
            <nav class="admin-nav">
                <a class="@Active("/Admin/Index")" asp-page="/Admin/Index"><i class="bi bi-speedometer2"></i>@L["Dashboard"]</a>

                <div class="admin-nav-group">@L["Clinic"]</div>
                <a class="@Active("/Admin/Appointments")" asp-page="/Admin/Appointments"><i class="bi bi-calendar3"></i>@L["Appointments"]</a>
                <a class="@Active("/Admin/Patients")" asp-page="/Admin/Patients/Index"><i class="bi bi-people"></i>@L["Patients"]</a>
                @if (!Scope.IsOwnOnly)
                {
                    <a class="@Active("/Admin/Doctors")" asp-page="/Admin/Doctors/Index"><i class="bi bi-person-badge"></i>@L["Doctors"]</a>
                }
                <a class="@Active("/Admin/Messages")" asp-page="/Admin/Messages"><i class="bi bi-envelope"></i>@L["Messages"]@if (unread > 0) { <span class="badge rounded-pill bg-warning text-dark ms-auto">@Fmt.Number(unread)</span> }</a>
                @if (isAdmin)
                {
                    <a class="@Active("/Admin/Schedule")" asp-page="/Admin/Schedule"><i class="bi bi-clock"></i>@L["Doctors' working hours"]</a>
                }

                <div class="admin-nav-group">@L["Reports"]</div>
                <a class="@(path == "/Admin/Reports/Index" ? "active" : "")" asp-page="/Admin/Reports/Index"><i class="bi bi-file-earmark-bar-graph"></i>@L["Visit reports"]</a>
                @if (isAdmin)
                {
                    <a class="@Active("/Admin/Reports/Charts")" asp-page="/Admin/Reports/Charts"><i class="bi bi-pie-chart"></i>@L["Clinic charts"]</a>
                }

                @if (isAdmin || isDoctor)
                {
                    <div class="admin-nav-group">@L["Content"]</div>
                    <a class="@(path.StartsWith("/Admin/Posts") && Context.Request.Query["kind"] != "Article" ? "active" : "")" asp-page="/Admin/Posts/Index" asp-route-kind="Blog"><i class="bi bi-journal-richtext"></i>@L["Blog"]</a>
                    <a class="@(path.StartsWith("/Admin/Posts") && Context.Request.Query["kind"] == "Article" ? "active" : "")" asp-page="/Admin/Posts/Index" asp-route-kind="Article"><i class="bi bi-file-earmark-medical"></i>@L["Medical articles"]</a>
                }
                @if (isAdmin)
                {
                    <a class="@Active("/Admin/Site")" asp-page="/Admin/Site"><i class="bi bi-house-gear"></i>@L["Home page and contact"]</a>
                    <a class="@Active("/Admin/Results")" asp-page="/Admin/Results"><i class="bi bi-bar-chart-line"></i>@L["Results on the home page"]</a>

                    <div class="admin-nav-group">@L["Settings"]</div>
                    <a class="@Active("/Admin/Users")" asp-page="/Admin/Users"><i class="bi bi-person-gear"></i>@L["Users"]</a>
                    <a class="@Active("/Admin/DoctorRequests")" asp-page="/Admin/DoctorRequests"><i class="bi bi-person-check"></i>@L["Doctor requests"]@if (pendingDoctors > 0) { <span class="badge rounded-pill bg-warning text-dark ms-auto">@Fmt.Number(pendingDoctors)</span> }</a>
                    <a class="@Active("/Admin/Services")" asp-page="/Admin/Services"><i class="bi bi-grid"></i>@L["Services"]</a>
                    <a class="@Active("/Admin/Audit")" asp-page="/Admin/Audit"><i class="bi bi-shield-check"></i>@L["Access log"]</a>
                }
                @if (isOwner)
                {
                    <div class="admin-nav-group">@L["Site owner"]</div>
                    <a class="@Active("/Admin/Branding")" asp-page="/Admin/Branding"><i class="bi bi-palette"></i>@L["Logo, name and colours"]</a>
                }
            </nav>
        </aside>

        <div class="admin-main">
            <header class="admin-topbar">
                <button class="btn btn-outline-secondary d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#adminSidebar" aria-controls="adminSidebar" aria-label="@L["Menu"]"><i class="bi bi-list"></i></button>
                <div class="admin-user">
                    <span class="admin-user-avatar" aria-hidden="true"><i class="bi bi-person"></i></span>
                    <span class="admin-user-text">
                        <strong>@userName</strong>
                        @if (roleNames.Length > 0) { <small>@roleNames</small> }
                    </span>
                </div>
                <div class="ms-auto d-flex align-items-center gap-2">
                    <a class="btn btn-sm btn-light" asp-page="/Index" target="_blank"><i class="bi bi-box-arrow-up-right"></i><span class="d-none d-sm-inline ms-1">@L["View site"]</span></a>
                    <a class="btn btn-sm btn-light" href="@CulturePath.SwitchUrl(Context.Request)">@(english ? "فارسی" : "English")</a>
                    <form method="post" asp-page="/Account/Logout" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-danger">@L["Log out"]</button>
                    </form>
                </div>
            </header>
            <main class="admin-content">
                @if (TempData["Message"] is string message)
                {
                    <div class="alert alert-success">@message</div>
                }
                @if (TempData["Error"] is string error)
                {
                    <div class="alert alert-danger">@error</div>
                }
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/behaviors.js" asp-append-version="true"></script>
    <partial name="_FormScripts" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
