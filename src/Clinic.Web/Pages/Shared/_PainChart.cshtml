@model List<(DateTime Utc, int Score)>
@{
    // Pain score (0 to 10) per session, drawn like the weight chart; no chart library needed.
    const double W = 640, H = 200, Left = 44, Right = 16, Top = 16, Bottom = 34, Pad = 16;
    var points = Model;
    var t0 = points[0].Utc.Ticks;
    var span = Math.Max(1, points[^1].Utc.Ticks - t0);
    double Px(DateTime utc) => points.Count == 1 ? (Left + W - Right) / 2 : Left + Pad + (utc.Ticks - t0) / (double)span * (W - Left - Right - 2 * Pad);
    double Py(double score) => Top + (10 - score) / 10 * (H - Top - Bottom);
    // SVG numbers must use a dot whatever the page language.
    static string F(double v) => v.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
    var line = string.Join(" ", points.Select(p => $"{F(Px(p.Utc))},{F(Py(p.Score))}"));
    var change = points[^1].Score - points[0].Score;
}
<div class="weight-chart pain-chart">
    <svg viewBox="0 0 @F(W) @F(H)" role="img" aria-label="@L["Pain score over time"]" dir="ltr">
        @for (var score = 0; score <= 10; score += 2)
        {
            var y = Py(score);
            <g><line x1="@F(Left)" x2="@F(W - Right)" y1="@F(y)" y2="@F(y)" class="grid" /><text x="@F(Left - 6)" y="@F(y + 4)" text-anchor="end">@Fmt.Number(score)</text></g>
        }
        <polyline points="@line" class="line" />
        @foreach (var p in points)
        {
            <circle cx="@F(Px(p.Utc))" cy="@F(Py(p.Score))" r="4" class="dot"><title>@Fmt.Date(p.Utc): @Fmt.Number(p.Score)</title></circle>
        }
        <text x="@F(Left + 34)" y="@F(H - 10)" text-anchor="middle">@Fmt.ShortDate(points[0].Utc)</text>
        @if (points.Count > 1)
        {
            <g><text x="@F(W - Right - 34)" y="@F(H - 10)" text-anchor="middle">@Fmt.ShortDate(points[^1].Utc)</text></g>
        }
    </svg>
    @if (points.Count > 1)
    {
        <div class="small mt-2 @(change < 0 ? "text-success" : change > 0 ? "text-danger" : "text-muted")">
            <i class="bi @(change <= 0 ? "bi-arrow-down-right" : "bi-arrow-up-right") me-1"></i>
            @L["Change since the first session: {0} points", Fmt.Number((change > 0 ? "+" : "") + change.ToString(System.Globalization.CultureInfo.InvariantCulture))]
        </div>
    }
</div>
