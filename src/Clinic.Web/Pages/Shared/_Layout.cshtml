@inject Clinic.Web.Media.SiteContentProvider SiteContent
@{
    var english = CulturePath.IsEnglish;
    var site = await SiteContent.GetAsync();
    var fullWidth = ViewData["FullWidth"] as bool? == true;
}
<!DOCTYPE html>
<html lang="@(english ? "en" : "fa")" dir="@(english ? "ltr" : "rtl")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @L["Dr. Mahsa Hassani Acupuncture Clinic"]</title>
    <link rel="icon" href="~/favicon.ico" sizes="any" />
    <link rel="icon" href="~/img/favicon-32.png" type="image/png" />
    <link rel="apple-touch-icon" href="~/img/apple-touch-icon.png" />
    @if (ViewData["Description"] is string description)
    {
        <meta name="description" content="@description" />
    }
    <link rel="alternate" hreflang="@(english ? "fa" : "en")" href="@CulturePath.SwitchUrl(Context.Request)" />
    <link rel="stylesheet" href="~/lib/vazirmatn/vazirmatn.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <meta name="theme-color" content="#4b5d2e" />
    @if (english)
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    }
    else
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    }
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light site-nav sticky-top">
            <div class="container">
                <a class="navbar-brand" asp-page="/Index"><img src="~/img/logo.png" alt="" class="brand-logo" width="44" height="51" /><span class="brand-text"><span>@L["Acupuncture Clinic"]</span><small>@L["Dr. Mahsa Hassani"]</small></span></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-expanded="false" aria-label="@L["Menu"]">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" asp-page="/Index">@L["Home"]</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Blog/Index">@L["Blog"]</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Articles/Index">@L["Articles"]</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Contact">@L["Contact us"]</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Booking/Index">@L["Book an appointment"]</a></li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item"><a class="nav-link" asp-page="/Appointments/Mine">@L["My appointments"]</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Files/Index">@L["My files"]</a></li>
                        }
                    </ul>
                    <ul class="navbar-nav align-items-lg-center gap-lg-2">
                        <li class="nav-item">
                            <a class="nav-link" href="@CulturePath.SwitchUrl(Context.Request)" hreflang="@(english ? "fa" : "en")">@(english ? "فارسی" : "English")</a>
                        </li>
                        @if (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Doctor) || User.IsInRole(Roles.Receptionist))
                        {
                            <li class="nav-item"><a class="btn btn-outline-success" asp-page="/Admin/Index"><i class="bi bi-speedometer2 me-1" aria-hidden="true"></i>@L["Management panel"]</a></li>
                        }
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <form method="post" asp-page="/Account/Logout" class="d-inline">
                                    <button type="submit" class="btn btn-link nav-link">@L["Log out"]</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-page="/Account/Login">@L["Log in"]</a></li>
                            <li class="nav-item dropdown">
                                <button class="btn btn-success dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">@L["Sign up"]</button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" asp-page="/Account/Register"><i class="bi bi-person me-2"></i>@L["Patient sign up"]</a></li>
                                    <li><a class="dropdown-item" asp-page="/Account/RegisterDoctor"><i class="bi bi-heart-pulse me-2"></i>@L["Doctor sign up"]</a></li>
                                </ul>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    @if (TempData["Message"] is string message)
    {
        <div class="container mt-3"><div class="alert alert-success">@message</div></div>
    }
    @if (fullWidth)
    {
        <main role="main">@RenderBody()</main>
    }
    else
    {
        <main role="main" class="container py-4 pb-5">@RenderBody()</main>
    }

    <footer class="site-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-5">
                    <h2 class="d-flex align-items-center gap-2"><span class="brand-logo-chip"><img src="~/img/logo.png" alt="" class="brand-logo" width="44" height="51" /></span>@L["Dr. Mahsa Hassani Acupuncture Clinic"]</h2>
                    <p class="mt-3 mb-0">@site.HeroSubtitle(english)</p>
                </div>
                <div class="col-sm-6 col-lg-4">
                    <h2>@L["Contact us"]</h2>
                    <ul class="list-unstyled mb-0 d-grid gap-2 mt-3">
                        @if (site.Phone is not null)
                        {
                            <li><i class="bi bi-telephone me-2" aria-hidden="true"></i><a href="tel:@site.Phone" dir="ltr">@Fmt.Number(site.Phone)</a></li>
                        }
                        @if (site.Address(english) is string address)
                        {
                            <li><i class="bi bi-geo-alt me-2" aria-hidden="true"></i>@address</li>
                        }
                        <li><i class="bi bi-calendar2-check me-2" aria-hidden="true"></i><a asp-page="/Booking/Index">@L["Book an appointment"]</a></li>
                        <li><i class="bi bi-envelope me-2" aria-hidden="true"></i><a asp-page="/Contact">@L["Send a message to the doctor"]</a></li>
                    </ul>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <h2>@L["Follow us"]</h2>
                    <div class="social d-flex gap-2 mt-3">
                        @if (site.InstagramUrl is not null) { <a href="@site.InstagramUrl" target="_blank" rel="noopener" aria-label="Instagram"><i class="bi bi-instagram"></i></a> }
                        @if (site.WhatsAppUrl is not null) { <a href="@site.WhatsAppUrl" target="_blank" rel="noopener" aria-label="WhatsApp"><i class="bi bi-whatsapp"></i></a> }
                        @if (site.TelegramUrl is not null) { <a href="@site.TelegramUrl" target="_blank" rel="noopener" aria-label="Telegram"><i class="bi bi-telegram"></i></a> }
                        @if (site.YouTubeUrl is not null) { <a href="@site.YouTubeUrl" target="_blank" rel="noopener" aria-label="YouTube"><i class="bi bi-youtube"></i></a> }
                    </div>
                </div>
            </div>
            <hr class="border-secondary-subtle my-4" />
            <div class="small">&copy; @Fmt.Number(english ? DateTime.UtcNow.Year.ToString() : Clinic.Application.Common.JalaliDate.Year(DateTime.UtcNow).ToString()) @L["Dr. Mahsa Hassani Acupuncture Clinic"]</div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_FormScripts" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
