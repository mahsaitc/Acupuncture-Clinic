@model string[]
<div class="alert alert-warning mb-4" role="alert">
    <h2 class="h5"><i class="bi bi-exclamation-triangle me-2" aria-hidden="true"></i>@L["Save your recovery codes"]</h2>
    <p class="mb-2">@L["If you lose your phone, each of these codes lets you log in once instead of the app code. Write them down or print this page and keep them somewhere safe. They are shown only now."]</p>
    <div class="row row-cols-2 row-cols-md-5 g-2 font-monospace" dir="ltr">
        @foreach (var code in Model)
        {
            <div class="col"><span class="badge bg-light text-dark border fs-6 w-100">@code</span></div>
        }
    </div>
    <button type="button" class="btn btn-sm btn-outline-secondary mt-3" data-print><i class="bi bi-printer me-1" aria-hidden="true"></i>@L["Print"]</button>
</div>
